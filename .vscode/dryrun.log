grep -E '^[a-zA-Z_-]+(\([^)]*\))?:.*?## .*$' Makefile 2>/dev/null | sort | \
	awk 'BEGIN {FS = ":.*?## "}; { \
		cmd = $1; \
		desc = $2; \
		if (match(cmd, /\([^)]+\)/)) { \
			args = substr(cmd, RSTART+1, RLENGTH-2); \
			gsub(/\([^)]+\)/, "", cmd); \
			printf "  \033[36m%-20s\033[0m \033[33m%-15s\033[0m %s\n", cmd, args, desc; \
		} else { \
			printf "  \033[36m%-20s\033[0m \033[33m%-15s\033[0m %s\n", cmd, "", desc; \
		} \
	}'
echo ""
